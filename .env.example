# Copy to .env and change the secrets before running `docker compose up --build`.
POSTGRES_DB=aptechka
POSTGRES_USER=aptechka
POSTGRES_PASSWORD=change-me

# HTTP Basic credentials for the API (Spring Security).
APP_USER=admin
APP_PASSWORD=change-me

# Comma-separated origins the frontend is served from.
CORS_ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# Backend URL as seen from the browser (rebuild the frontend after changing it).
VITE_API_URL=http://localhost:8080
